# Example environment configuration for smolagents
# Copy this file to .env and fill in your values

# =============================================================================
# API Keys (Required - set at least one based on your model choice)
# =============================================================================

# HuggingFace API key (for HfApiModel)
HF_API_KEY=your_huggingface_api_key_here
# Alternative: HUGGING_FACE_HUB_TOKEN=your_token_here

# OpenAI API key (for OpenAI models via LiteLLM)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API key (for Claude models via LiteLLM)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# E2B API key (for sandboxed code execution)
E2B_API_KEY=your_e2b_api_key_here

# =============================================================================
# Server Configuration
# =============================================================================

# Server host and port
SMOLAGENTS_HOST=0.0.0.0
SMOLAGENTS_PORT=8000

# Number of worker processes (for production)
SMOLAGENTS_WORKERS=1

# =============================================================================
# Agent Configuration
# =============================================================================

# Maximum number of reasoning steps
SMOLAGENTS_MAX_STEPS=10

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
SMOLAGENTS_LOG_LEVEL=INFO

# =============================================================================
# Security Settings
# =============================================================================

# Use E2B sandboxed execution (true/false)
SMOLAGENTS_USE_E2B=false

# Enable audit logging
SMOLAGENTS_AUDIT_ENABLED=true

# =============================================================================
# Performance Settings
# =============================================================================

# Enable caching
SMOLAGENTS_CACHE_ENABLED=true

# Cache size
SMOLAGENTS_CACHE_SIZE=128

# Cache TTL in seconds
SMOLAGENTS_CACHE_TTL=3600

# Enable rate limiting
SMOLAGENTS_RATE_LIMIT_ENABLED=true

# Rate limit: max calls per time window
SMOLAGENTS_RATE_LIMIT_MAX_CALLS=100

# Rate limit: time window in seconds
SMOLAGENTS_RATE_LIMIT_WINDOW=60

# =============================================================================
# CORS Settings (for API server)
# =============================================================================

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=*

# =============================================================================
# Monitoring (Optional)
# =============================================================================

# Grafana admin password
GRAFANA_PASSWORD=admin

# =============================================================================
# Development Settings
# =============================================================================

# Enable debug mode
DEBUG=false

# Enable verbose logging
VERBOSE=false
